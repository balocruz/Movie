TMDB_ACCESS_TOKEN=
GEMINI_API_KEY=
# Maximum output tokens for an explicitly detailed Maya answer (default: 2200; max: 3000).
MAYA_MAX_OUTPUT_TOKENS=2200
# Set true to enable Google Search grounding for current seasons, episode dates,
# and other time-sensitive screen facts. It uses the existing Gemini key and
# adds a Gemini web-grounding request only for matching questions. Check Gemini
# billing first: it is not available on every free API tier. Gemini 3's paid
# tier currently includes 5,000 search queries/month, then charges per query.
MAYA_WEB_SEARCH_ENABLED=false
# Add capacitor://localhost or other app origins here if required.
GEMINI_ALLOWED_ORIGINS=https://localhost,capacitor://localhost
